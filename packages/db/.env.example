# Solo servidor. Copiar cadenas reales desde Connect; codificar la contrasena.
# Runtime por Supavisor session pooler (IPv4), con TLS verificado por pg.
# Si la CA no es de confianza, configurar sslrootcert con su ruta local real.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full"

# Prisma CLI: session pooler o conexion directa si la red lo permite.
# require exige cifrado; completar/verificar confianza del certificado antes de conectar.
# Prisma CLI documenta sslcert para la CA; no copiar sslrootcert de pg sin verificar.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
