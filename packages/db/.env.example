# Desarrollo local L1: PostgreSQL nativo dedicado, solo loopback, sin TLS local.
# Sustituir PASSWORD por la contrasena local; no usar estos ejemplos como credenciales.
# Runtime y Prisma CLI deben apuntar al MISMO destino. Sin fallback remoto.
DATABASE_URL="postgresql://fallout_app:PASSWORD@127.0.0.1:55432/fallout_platform_dev?schema=public&sslmode=disable"
DIRECT_URL="postgresql://fallout_app:PASSWORD@127.0.0.1:55432/fallout_platform_dev?schema=public&sslmode=disable"

# Produccion: configurar aparte. TLS remoto estricto siempre, con CA/hostname
# verificados. pg usa sslmode=verify-full/sslrootcert; Prisma CLI sslmode=require,
# sslaccept=strict/sslcert. No copiar sslmode=disable al entorno remoto.
