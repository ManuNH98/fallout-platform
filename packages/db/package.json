{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc --project tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "prisma generate && tsc --noEmit",
    "clean": "rm -rf dist generated",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "prisma db execute --file prisma/check-connection.sql",
    "db:check:runtime": "prisma generate && tsc --project tsconfig.runtime-check.json && node dist/runtime-check/scripts/check-runtime.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "prisma": "7.9.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "^8.22.0"
  }
}
