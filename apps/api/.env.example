NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# PostgreSQL de desarrollo nativo, dedicado y limitado a loopback.
# Sustituir PASSWORD; usar la misma DB y credenciales que packages/db/.env.
# Sin TLS solo en este loopback local. Produccion requiere TLS estricto y CA.
DATABASE_URL="postgresql://fallout_app:PASSWORD@127.0.0.1:55432/fallout_platform_dev?schema=public&sslmode=disable"

# Origen HTTPS del proyecto, sin credenciales, ruta, query ni fragmento.
# El verificador ES256 usa JWKS publico; no requiere JWT secret ni API key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=media
