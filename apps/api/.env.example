NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# Solo servidor. Copiar el endpoint real desde Connect; codificar la contrasena.
# Runtime persistente por Supavisor session pooler (IPv4), con TLS verificado por pg.
# Si la CA no es de confianza, configurar sslrootcert con su ruta local real.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full"

# Origen HTTPS del proyecto, sin credenciales, ruta, query ni fragmento.
# El verificador ES256 usa JWKS publico; no requiere JWT secret ni API key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=media
